{
  // Unit tests for the pure analysis code (models, rules, engine, summary, utils).
  // Anything that imports "@adsk/fusion" can't compile here, which keeps Fusion API code out of the pure layer.
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".test-build",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["tests/**/*.ts"]
}
